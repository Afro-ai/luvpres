# ============================================================
# LOVE Platform - Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Cloudflare Account
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# KV Namespace IDs (from: wrangler kv:namespace create "love-data")
KV_NAMESPACE_ID=your_kv_namespace_id
KV_PREVIEW_ID=your_kv_preview_id

# Worker Secrets (set via: wrangler secret put SECRET_NAME)
JWT_SECRET=generate_a_32_character_random_string
GEMINI_KEY=your_gemini_api_key

# Stripe (Phase 4 - Optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Local Development
VITE_API_URL=http://localhost:8787
